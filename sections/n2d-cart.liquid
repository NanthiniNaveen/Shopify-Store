<div class="container"><header class="page-heading"><div class="eyebrow">Your selection</div><h1>Shopping bag</h1></header>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row">{% assign bag_colour = '' %}{% for bag_option in item.options_with_values %}{% assign bag_option_name = bag_option.name | downcase %}{% if bag_option_name contains 'color' or bag_option_name contains 'colour' %}{% assign bag_colour = bag_option.value %}{% endif %}{% endfor %}{% capture bag_colour_image %}{% render 'n2d-regular-colour-image', handle: item.product.handle, colour: bag_colour %}{% endcapture %}{% assign bag_colour_image = bag_colour_image | strip %}{% if bag_colour_image != blank %}<img src="{{ bag_colour_image }}" alt="{{ item.product.title | escape }} in {{ bag_colour | escape }}" loading="lazy" width="192" height="240">{% elsif item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{% endif %}<div><h3><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h3><p class="muted">{{ item.variant.title | escape }}</p><label class="form-label" for="Quantity-{{ forloop.index }}">Quantity</label><div class="qty-stepper" data-qty-stepper><button class="qty-btn" type="button" data-qty-minus aria-label="Decrease quantity">−</button><input class="field qty-input" type="number" id="Quantity-{{ forloop.index }}" name="updates[]" value="{{ item.quantity }}" min="1" inputmode="numeric" data-cart-qty data-remove-url="{{ item.url_to_remove }}"><button class="qty-btn" type="button" data-qty-plus aria-label="Increase quantity">+</button></div><a class="line-link" href="{{ item.url_to_remove }}">Remove</a></div><div>₹{{ item.final_line_price | money_without_currency | split: "." | first }}</div></div>{% endfor %}<div class="cart-total"><p>Subtotal ₹{{ cart.total_price | money_without_currency | split: "." | first }}</p><p class="muted">Shipping and any applicable taxes are calculated at checkout.</p><div class="button-row" style="justify-content:end"><button class="button outline" name="update" type="submit">Update bag</button>{% if settings.enable_purchasing %}<button class="button" name="checkout" type="submit">Checkout</button>{% else %}<button class="button" type="button" disabled>Purchasing unavailable</button>{% endif %}</div></div></form>{% else %}<div class="empty-state"><h2>Your next story is waiting.</h2><p>Your bag is empty.</p><a class="button outline" href="{{ routes.all_products_collection_url }}">Explore all pieces</a></div>{% endif %}<script>document.querySelectorAll('[data-qty-stepper]').forEach(w=>{const i=w.querySelector('[data-cart-qty]');const go=()=>{const v=parseInt(i.value||'0',10);if(v<1){location.href=i.dataset.removeUrl}else{i.closest('form').submit()}};w.querySelector('[data-qty-minus]').addEventListener('click',()=>{i.value=Math.max(0,parseInt(i.value||'1',10)-1);go()});w.querySelector('[data-qty-plus]').addEventListener('click',()=>{i.value=parseInt(i.value||'0',10)+1;go()});i.addEventListener('change',go)})</script>
<style>.qty-stepper{display:inline-flex;align-items:center;gap:0;border:1px solid var(--line,#ddd);border-radius:8px;overflow:hidden}.qty-stepper .qty-btn{width:34px;height:38px;border:0;background:transparent;font-size:18px;cursor:pointer;color:inherit}.qty-stepper .qty-btn:hover{background:rgba(0,0,0,.06)}.qty-stepper .qty-input{width:52px;text-align:center;border:0;border-left:1px solid var(--line,#ddd);border-right:1px solid var(--line,#ddd);border-radius:0;padding:8px 4px;-moz-appearance:textfield}.qty-stepper .qty-input::-webkit-outer-spin-button,.qty-stepper .qty-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}</style>
</div>{% schema %}{"name":"Shopping bag","settings":[]}{% endschema %}