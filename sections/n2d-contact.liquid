<div class="container"><header class="page-heading"><div class="eyebrow">Here to help</div><h1>Contact</h1><p>Questions about N2D? Send us a message.</p></header><div class="page-prose">{% if settings.contact_email != blank %}<p>Email: <a href="mailto:{{ settings.contact_email | escape }}">{{ settings.contact_email | escape }}</a></p>{% endif %}{% if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif %}{% form 'contact' %}{% if form.posted_successfully? %}<p class="note" role="status">Thank you. Your message has been sent.</p>{% endif %}{{ form.errors | default_errors }}<div class="form-grid"><div class="form-row"><label class="form-label" for="ContactName">Name</label><input class="field" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | escape }}" required></div><div class="form-row"><label class="form-label" for="ContactEmail">Email</label><input class="field" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" value="{{ form.email | escape }}" required></div></div><div class="form-row"><label class="form-label" for="ContactMessage">Message</label><textarea class="field" id="ContactMessage" name="contact[body]" rows="6" required>{{ form.body | escape }}</textarea></div><button class="button" type="submit">Send message <span aria-hidden="true">↗</span></button>{% endform %}</div></div>{% schema %}{"name":"Contact","settings":[]}{% endschema %}