{% assign featured = section.settings.collection %}{% if featured != blank and featured.products_count > 0 %}<section class="section"><div class="container"><div class="section-head"><h2>{{ section.settings.heading | escape }}</h2><a class="line-link" href="{{ featured.url }}">Explore all <span class="arrow">↗</span></a></div><div class="art-grid">{% for product in featured.products limit: 8 %}{% render 'n2d-product-card', product: product %}{% endfor %}</div></div></section>{% endif %}{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"heading","label":"Heading","default":"Find your next story."},{"type":"collection","id":"collection","label":"Collection"}],"presets":[{"name":"Featured collection"}]}{% endschema %}