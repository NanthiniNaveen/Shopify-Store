{% if section.settings.announcement != blank %}<div class="announcement">{{ section.settings.announcement | escape }}</div>{% endif %}
<header class="site-header">
<button class="icon-button menu-toggle" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="MobileMenu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg></button>
<a class="brand" href="{{ routes.root_url }}" aria-label="N2D home">{% if settings.logo %}{{ settings.logo | image_url: width: 240 | image_tag: width: 105, alt: 'N2D' }}{% else %}<img class="brand-circle" src="{{ 'n2d-circle-ivory.svg' | asset_url }}" width="64" height="64" alt="N2D">{% endif %}</a>
<nav class="nav-links" aria-label="Main navigation">{% assign regular_url = '/collections/regular' %}{% if settings.regular_collection != blank %}{% assign regular_url = settings.regular_collection.url %}{% endif %}
{% assign oversized_url = '/collections/oversized' %}{% if settings.oversized_collection != blank %}{% assign oversized_url = settings.oversized_collection.url %}{% endif %}
<div class="nav-item"><a href="/pages/mens-collection">Men</a><div class="nav-dropdown"><p>Choose your fit</p><a href="/collections/regular"><span><strong>Regular</strong><small>Classic shape · Front artwork</small></span></a><a href="/collections/oversized"><span><strong>Oversized</strong><small>Relaxed shape · Back artwork</small></span></a><a href="/pages/mens-plain-essentials"><span><strong>Plain Essentials</strong><small>Quiet staples · N2D finish</small></span></a><a href="/pages/mens-collection#mens-polo"><span><strong>Polo</strong><small>Structured piqué · Chest artwork</small></span><span class="nav-dropdown__badge">Soon</span></a></div></div><div class="nav-item"><a href="/pages/womens-collection">Women</a><div class="nav-dropdown"><p>Choose your style</p><a href="/pages/womens-collection?view=womens-regular-tees"><span><strong>Regular Tee</strong><small>28 designs · 12 colours</small></span></a><a href="/collections/crop-tops"><span><strong>Crop Tops</strong><small>30 designs · ₹399</small></span></a><a href="/pages/womens-plain-essentials"><span><strong>Plain Essentials</strong><small>Plain tee · every colour</small></span></a></div></div><a href="{{ settings.family_url | default: '/pages/family-combos' }}">Family Combos</a><a href="/collections/toddler">Kids</a></nav>
<div class="header-actions">{% for block in section.blocks %}{% render block %}{% endfor %}<a class="icon-button" href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg></a><a class="icon-button" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c0-4.2 3.4-6.5 7.5-6.5s7.5 2.3 7.5 6.5"/></svg></a><a class="icon-button" href="/a/wishlist-hero/wishlist" aria-label="Wishlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 5.8a5.2 5.2 0 0 0-7.4 0L12 7.2l-1.4-1.4a5.2 5.2 0 1 0-7.4 7.4L12 22l8.8-8.8a5.2 5.2 0 0 0 0-7.4Z"/></svg></a><a class="icon-button" href="{{ routes.cart_url }}" aria-label="Shopping bag"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M8 8V6a4 4 0 0 1 8 0v2"/></svg></a></div></header>
<div class="mobile-menu" id="MobileMenu" data-mobile-menu hidden role="dialog" aria-modal="true" aria-label="Navigation"><div class="mobile-menu-top"><a class="brand" href="{{ routes.root_url }}"><img class="brand-circle" src="{{ 'n2d-circle-ivory.svg' | asset_url }}" width="64" height="64" alt="N2D"></a><button class="icon-button" data-menu-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg></button></div><nav aria-label="Mobile navigation">{% assign regular_url = '/collections/regular' %}{% if settings.regular_collection != blank %}{% assign regular_url = settings.regular_collection.url %}{% endif %}
{% assign oversized_url = '/collections/oversized' %}{% if settings.oversized_collection != blank %}{% assign oversized_url = settings.oversized_collection.url %}{% endif %}
<a href="/pages/mens-collection">Men</a><div class="mobile-subnav"><a href="/collections/regular">Regular</a><a href="/collections/oversized">Oversized</a><a href="/pages/mens-plain-essentials">Plain Essentials</a><a href="/pages/mens-collection#mens-polo">Polo · Coming soon</a></div><a href="/pages/womens-collection">Women</a><div class="mobile-subnav"><a href="/pages/womens-collection?view=womens-regular-tees">Regular Tee</a><a href="/collections/crop-tops">Crop Tops</a><a href="/pages/womens-plain-essentials">Plain Essentials</a></div><a href="{{ settings.family_url | default: '/pages/family-combos' }}">Family Combos</a><a href="/collections/toddler">Kids</a></nav><div class="mobile-menu-bottom">Stories you can wear.</div></div>
