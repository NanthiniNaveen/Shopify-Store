<section class="hero hero-media"><img class="hero-bg" src="{{ 'hero-lifestyle.webp' | asset_url }}" alt="Models wearing N2D tees — front and back artwork" width="1024" height="682"><div class="hero-scrim" aria-hidden="true"></div><div class="hero-copy"><div class="eyebrow">{{ section.settings.eyebrow | escape }}</div><h1>ART YOU <em class="hero-accent">LIVE&nbsp;IN.</em></h1><p>{{ section.settings.text | escape }}</p><div class="button-row">{% assign regular_url = '/collections/regular' %}{% if settings.regular_collection != blank %}{% assign regular_url = settings.regular_collection.url %}{% endif %}{% assign oversized_url = '/collections/oversized' %}{% if settings.oversized_collection != blank %}{% assign oversized_url = settings.oversized_collection.url %}{% endif %}<a class="button" href="{{ regular_url }}">Shop Regular <span aria-hidden="true">↗</span></a><a class="button outline" href="{{ oversized_url }}">Shop Oversized <span aria-hidden="true">↗</span></a></div></div><div class="image-caption"><span>Regular / front artwork</span><span>Oversized / back artwork</span></div></section><div class="fit-strip"><a class="fit-mini" href="{{ regular_url }}"><img src="{{ 'fit-thumb-regular.webp' | asset_url }}" alt="" width="64" height="64"><div><h3>Regular</h3><p>Classic fit. Front artwork.</p></div><span class="fit-mini-arrow" aria-hidden="true">↗</span></a><a class="fit-mini" href="{{ oversized_url }}"><img src="{{ 'fit-thumb-oversized.webp' | asset_url }}" alt="" width="64" height="64"><div><h3>Oversized</h3><p>Relaxed fit. Back artwork.</p></div><span class="fit-mini-arrow" aria-hidden="true">↗</span></a></div><div class="hero-strip"><span>India-inspired artwork. Your everyday canvas.</span><a class="line-link" href="{{ settings.story_url | default: '/pages/our-story' }}">Our story <span aria-hidden="true">↗</span></a></div>
