<div class="container"><header class="page-heading"><h1>Find your silhouette.</h1></header><div class="art-grid">{% for collection in collections %}<article class="art-card"><a href="{{ collection.url }}"><div class="art-card-image">{% if collection.image %}{{ collection.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div><h3>{{ collection.title | escape }}</h3></a></article>{% endfor %}</div><div class="collection-bottom"></div></div>{% schema %}{"name":"Collections","settings":[]}{% endschema %}