<div data-catalogue-mount="plain"></div>

<section class="women-plain section" id="women-plain">
  <div class="container">
    <header class="women-plain__head">
      <h2>Plain essentials for her.</h2>
      <p>Clean silhouettes, no artwork. The Women’s Regular Tee in every colour.</p>
    </header>
    <div class="women-plain__grid">
      <article class="women-plain__product">
        <a class="women-plain__visual women-plain__visual--photo" href="/products/womens-plain-regular" aria-label="View Women’s Plain Regular Tee colours and sizes">
          <img src="{{ 'women-plain-model.webp' | asset_url }}" alt="Model wearing the Women’s Plain Regular Tee in Light Pink" width="1024" height="1536">
        </a>
        <div class="women-plain__copy">
          <h3>Women’s Plain Regular Tee</h3>
          <p>Plain front and back. The same familiar fit, available in 12 colours and sizes XS–5XL.</p>
          <p class="image-caption">Light Pink shown · choose your colour and size inside</p>
          <a class="button" href="/products/womens-plain-regular">View colours &amp; sizes</a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
.women-plain{border-top:1px solid var(--line);background:#191916}
.women-plain__head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}
.women-plain__head h2{max-width:10ch;margin:0}
.women-plain__head p{max-width:48ch;margin:0;color:var(--muted)}
.women-plain__grid{display:grid;grid-template-columns:minmax(0,480px);gap:24px;margin-inline:auto}
.women-plain__product{min-width:0}
.women-plain__visual{display:grid;place-items:center;aspect-ratio:1/1;background:#e9e4da;overflow:hidden}
.women-plain__visual img{display:block;width:100%;height:100%;object-fit:contain}
.women-plain__visual--photo{aspect-ratio:4/5}
.women-plain__visual--photo img{object-fit:cover;object-position:center 24%}
.women-plain__copy{padding:20px 2px 0}
.women-plain__copy h3{font:clamp(27px,3vw,38px)/1.05 var(--display);margin:0 0 8px}
.women-plain__copy>p:not(.image-caption){color:var(--muted);max-width:58ch}
@media(max-width:720px){
  .women-plain__head{display:block}
  .women-plain__head h2{font-size:38px;margin-bottom:14px}
  .women-plain__grid{grid-template-columns:1fr;gap:42px}
}
</style>

