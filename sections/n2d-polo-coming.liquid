<section class="polo-preview">
  <div class="container polo-preview__hero">
    <div class="polo-preview__copy">
      <p>Arriving soon</p>
      <h1>The N2D Polo.</h1>
      <span>Sharper structure. A subtle 4-inch chest detail. Built for the days that call for something more refined.</span>
      <a class="button outline" href="/pages/contact">Tell us your colour</a>
    </div>
    <div class="polo-preview__visual">
      <div class="polo-preview__shirt" aria-label="Polo concept illustration">
        <span class="polo-preview__collar"></span>
        <span class="polo-preview__placket"></span>
        <img src="{{ 'n2d-circle-ivory.svg' | asset_url }}" alt="N2D chest logo concept" width="80" height="80">
      </div>
      <p>Concept preview · Final garment may vary</p>
    </div>
  </div>
  <div class="polo-preview__details">
    <div class="container">
      <div><b>230 GSM</b><span>Piqué cotton</span></div>
      <div><b>4 × 4 in</b><span>Chest artwork</span></div>
      <div><b>S–5XL</b><span>Planned sizes</span></div>
      <div><b>DTF</b><span>Print finish</span></div>
    </div>
  </div>
  <div class="container section polo-preview__ideas">
    <h2>Small details. Strong identity.</h2>
    <p>We’re developing compact N2D marks and India-inspired motifs made specifically for the polo’s chest placement.</p>
    <div>
      <article><img src="{{ 'n2d-circle-ivory.svg' | asset_url }}" alt="N2D circle logo polo concept" width="150" height="150"><h3>Orbit Mark</h3><span>Coming soon</span></article>
      <article><img src="{{ 'family-orbit-king-light.svg' | asset_url }}" alt="N2D family orbit polo concept" width="150" height="150"><h3>Royal Orbit</h3><span>Coming soon</span></article>
      <article><img src="{{ 'family-royal-prince-light.svg' | asset_url }}" alt="N2D royal polo concept" width="150" height="150"><h3>Royal Crest</h3><span>Coming soon</span></article>
    </div>
  </div>
</section>
{% schema %}{"name":"Polo preview","settings":[],"presets":[{"name":"Polo preview"}]}{% endschema %}
