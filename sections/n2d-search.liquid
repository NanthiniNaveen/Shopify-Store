<div class="container"><header class="page-heading"><div class="eyebrow">Find your story</div><h1>Search</h1></header><form class="search-form" action="{{ routes.search_url }}" method="get"><label class="visually-hidden" for="SearchInput">Search all pieces</label><input class="field" id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search all pieces"><input type="hidden" name="type" value="product"><button class="button" type="submit">Search</button></form>{% if search.performed %}{% paginate search.results by 24 %}{% if search.results_count > 0 %}<div class="art-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'n2d-product-card',product:item %}{% endif %}{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pages">{{ paginate | default_pagination }}</nav>{% endif %}{% else %}<div class="empty-state"><h2>No pieces found.</h2><p>Try another word, or explore the studio artwork.</p><a class="button outline" href="{{ routes.root_url }}#studio-selection">Explore artwork</a></div>{% endif %}{% endpaginate %}{% endif %}<div class="collection-bottom"></div></div>{% schema %}{"name":"Search","settings":[]}{% endschema %}