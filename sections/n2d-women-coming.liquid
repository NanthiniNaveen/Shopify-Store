var DISPLAY_ORDER=["Birdsong","Bloom — In Your Own Time","Cherry Ribbon","Café Cat","Own — Your Story","Lunar Wings","Coastal Pause","More — Than Enough","Citrus Still Life","Wildflower Notes","Glow — From Within","Paper Flight","Terra Muse","Soft Power","Roller Daydream","Grateful","Sunlit Wings","Silhouette in Motion","Own Time","Pocket Marina","Everyday Muse","Cloud Clip","Girl Power","Last Light Mirror","Wild Grace","Filter Orbit","Hands Heart Sunset","Pixel Petal"];
var gallery=document.querySelector('.women-preview__designs');
if(gallery){
  var cardByName={};
  gallery.querySelectorAll('.women-design--clickable').forEach(function(card){cardByName[card.dataset.name]=card});
  DISPLAY_ORDER.forEach(function(name){if(cardByName[name])gallery.appendChild(cardByName[name])});
}
var cards=Array.prototype.slice.call(document.querySelectorAll('.women-design--clickable'));
function keyFor(card){
  var match=card.dataset.img.match(/women-ladies-(.+?)\.webp/);
  return match?match[1]:'';
}
var PRODUCT_URLS={
  'Bloom — In Your Own Time':'/products/bloom-in-your-own-time-womens-regular-t-shirt',
  'Own — Your Story':'/products/own-your-story-womens-regular-t-shirt',
  'More — Than Enough':'/products/more-than-enough-womens-regular-t-shirt',
  'Glow — From Within':'/products/glow-from-within-womens-regular-t-shirt',
  'Soft Power':'/products/soft-power-womens-regular-t-shirt',
  'Silhouette in Motion':'/products/silhouette-in-motion-womens-regular-t-shirt',
  'Wildflower Notes':'/products/wildflower-notes-womens-tee',
  'Caf\u00e9 Cat':'/products/cafe-cat-womens-tee',
  'Cafe Cat':'/products/cafe-cat-womens-tee',
  'Coastal Pause':'/products/coastal-pause-womens-regular-t-shirt',
  'Terra Muse':'/products/terra-muse-womens-tee',
  'Grateful':'/products/grateful-womens-tee',
  'Everyday Muse':'/products/everyday-muse-womens-tee',
  'Girl Power':'/products/girl-power-womens-regular-t-shirt',
  'Sunlit Wings':'/products/sunlit-wings-womens-regular-t-shirt',
  'Cherry Ribbon':'/products/cherry-ribbon-womens-regular-t-shirt',
  'Lunar Wings':'/products/lunar-wings-womens-regular-t-shirt',
  'Birdsong':'/products/birdsong-womens-regular-t-shirt',
  'Own Time':'/products/own-time-womens-regular-t-shirt',
  'Paper Flight':'/products/paper-flight-womens-regular-t-shirt',
  'Wild Grace':'/products/wild-grace-womens-regular-t-shirt',
  'Citrus Still Life':'/products/citrus-still-life-womens-regular-t-shirt',
  'Roller Daydream':'/products/roller-daydream-womens-regular-t-shirt',
  'Hands Heart Sunset':'/products/hands-heart-sunset-womens-regular-t-shirt',
  'Last Light Mirror':'/products/last-light-mirror-womens-regular-t-shirt',
  'Pocket Marina':'/products/pocket-marina-womens-regular-t-shirt',
  'Cloud Clip':'/products/cloud-clip-womens-regular-t-shirt',
  'Filter Orbit':'/products/filter-orbit-womens-regular-t-shirt',
  'Pixel Petal':'/products/pixel-petal-womens-regular-t-shirt'
};
function productUrl(key,card){
  if(card&&card.dataset.name&&PRODUCT_URLS[card.dataset.name])return PRODUCT_URLS[card.dataset.name];
  var url=new URL(window.location.href);
  url.searchParams.set('design',key);
  url.hash='';
  return url.toString();
}
cards.forEach(function(card){
  var key=keyFor(card);
  card.setAttribute('role','link');
  card.setAttribute('aria-label','View '+card.dataset.name);
  function navigate(){window.location.href=productUrl(key,card)}
  card.addEventListener('click',navigate);
  card.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();navigate()}});
});
var selectedKey=new URLSearchParams(window.location.search).get('design');
if(!selectedKey)return;
var card=cards.find(function(item){return keyFor(item)===selectedKey});
if(!card)return;
var page=document.getElementById('women-product-page');
var section=document.querySelector('.women-preview');
var photo=document.getElementById('wp-photo');
var swatches=document.getElementById('wp-swatches');
var sizes=document.getElementById('wp-sizes');
var thumbs=document.getElementById('wp-thumbs');
var selected=document.getElementById('wp-selected');
var baseMatch=card.dataset.img.match(/^(.*women-ladies-.+?)\.webp(\?.*)?$/);
if(!baseMatch)return;
var base=baseMatch[1],version=baseMatch[2]||'';
var defaultIndex=cards.indexOf(card)%COLOURS.length;
var current={colour:COLOURS[defaultIndex],size:'M'};
function imageUrl(colour){return base+'-'+colour[2]+'.webp'+version}
function sync(){
  photo.src=imageUrl(current.colour);
  photo.alt=card.dataset.name+' on a '+current.colour[0]+' women’s Regular Tee';
  selected.textContent=current.size+' / '+current.colour[0];
  swatches.querySelectorAll('button').forEach(function(button){button.setAttribute('aria-pressed',button.dataset.slug===current.colour[2]?'true':'false')});
  sizes.querySelectorAll('button').forEach(function(button){button.setAttribute('aria-pressed',button.textContent===current.size?'true':'false')});
  thumbs.querySelectorAll('button').forEach(function(button){button.setAttribute('aria-pressed',button.dataset.slug===current.colour[2]?'true':'false')});
}
COLOURS.forEach(function(colour){
  var button=document.createElement('button');
  button.type='button';button.className='native-colour';button.dataset.slug=colour[2];
  button.style.setProperty('--option-colour',colour[1]);
  button.innerHTML='<i aria-hidden="true"></i>'+colour[0];
  button.onclick=function(){current.colour=colour;sync()};
  swatches.appendChild(button);
  var thumb=document.createElement('button');
  thumb.type='button';thumb.className='media-thumb';thumb.dataset.slug=colour[2];
  thumb.setAttribute('aria-label','View '+colour[0]+' photo');
  thumb.innerHTML='<img src="'+imageUrl(colour)+'" alt="" loading="lazy" width="160" height="240">';
  thumb.onclick=function(){current.colour=colour;sync();window.scrollTo({top:0,behavior:'smooth'})};
  thumbs.appendChild(thumb);
});
SIZES.forEach(function(size){
  var button=document.createElement('button');
  button.type='button';button.className='native-size-btn';button.textContent=size;
  button.onclick=function(){current.size=size;sync()};
  sizes.appendChild(button);
});
document.getElementById('wp-name').textContent=card.dataset.name;
document.getElementById('wp-crumb').textContent=card.dataset.name;
document.title=card.dataset.name+' — N2D';
document.getElementById('wp-add').onclick=function(){
  var message=document.getElementById('wp-message');
  message.hidden=false;
  message.focus&&message.focus();
};
section.classList.add('is-product');
page.hidden=false;
sync();
window.scrollTo(0,0);
})();
</script>

