        </div>
        <div class="women-fit__copy"><h3>Crop Top</h3><p>A shorter silhouette, kept clean and plain.</p><b>Explore Plain Essentials ↗</b></div>
      </a>
    </div>
  </div>
  {% endunless %}

  {% if women_regular_page %}
