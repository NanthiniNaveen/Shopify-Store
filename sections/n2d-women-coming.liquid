{% assign women_regular_page = false %}
{% if template.suffix == 'womens-regular-tees' %}{% assign women_regular_page = true %}{% endif %}
<section class="women-preview{% if women_regular_page %} women-preview--regular-page{% endif %}">
  {% unless women_regular_page %}
  <div class="women-preview__hero container">
    <div class="women-preview__intro">
      <p class="women-preview__status">Women’s Collection</p>
      <h1>Made for her.<br><em>Still unmistakably N2D.</em></h1>
      <p>Everyday fits, expressive artwork and colours made to feel like yours.</p>
      <a class="button" href="#women-fits">Explore the collection <span aria-hidden="true">↓</span></a>
    </div>
    <div class="women-preview__art" aria-label="Women's collection artwork preview">
      <figure class="women-preview__look women-preview__look--main">
        <img src="{{ 'women-tee-wildflower.webp' | asset_url }}" alt="Wildflower Notes artwork on a white women's tee" width="2400" height="2400">
      </figure>
      <figure class="women-preview__look women-preview__look--secondary">
        <img src="{{ 'women-tee-cafecat.webp' | asset_url }}" alt="Café Cat artwork on a lavender women's tee" width="2400" height="2400">
      </figure>
      <span class="women-preview__stamp">N2D Women<br>2026</span>
    </div>
  </div>

  <div class="women-preview__ticker" aria-hidden="true">
    <span>Women’s Regular Tee</span><span>Plain Crop Top</span><span>12 colours</span>
  </div>

  <div class="container section" id="women-fits">
    <header class="women-preview__section-head">
      <h2>Choose your fit.</h2>
      <p>Explore the silhouettes, colours and artwork across the N2D women’s collection.</p>
    </header>

    <div class="women-preview__fits">
      <a class="women-fit women-fit--regular" href="/pages/womens-collection?view=womens-regular-tees">
        <div class="women-fit__visual">
          <img class="women-fit__product" src="{{ 'women-tee-wildflower.webp' | asset_url }}" alt="N2D women's Regular Tee preview" width="2400" height="2400">
          <span>12 colours</span>
        </div>
        <div class="women-fit__copy"><h3>Regular Tee</h3><p>Easy everyday fit. Full-size front artwork.</p><b>See previews ↓</b></div>
      </a>

      <a class="women-fit women-fit--crop" href="/pages/womens-plain-essentials#women-crop">
        <div class="women-fit__visual">
          <img class="women-fit__product" src="{{ 'women-crop-plain.webp' | asset_url }}" alt="N2D women's Crop Top preview" width="1300" height="1300">
