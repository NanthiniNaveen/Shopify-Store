<style>
.women-design--clickable{cursor:pointer;transition:transform .2s}
.women-design--clickable:hover{transform:translateY(-3px)}
.women-design--clickable:focus-visible{outline:2px solid var(--gold);outline-offset:5px}
.women-preview.is-product>.women-preview__hero,
.women-preview.is-product>.women-preview__ticker,
.women-preview.is-product>#women-fits,
.women-preview.is-product>.women-preview__gallery{display:none}
.women-product-page[hidden]{display:none}
.women-product-page,.women-product-page .product-grid,.women-product-page .product-grid>*{min-width:0}
.women-product-page .product-image{width:100%}
.women-product-page .media-thumbs{flex-wrap:wrap}
.women-product-page .media-thumb[aria-pressed="true"]{border-color:var(--gold)}
.women-product-page__message{font-size:14px;color:var(--muted);margin:12px 0 0}
.women-product-page .details-list a{text-decoration:underline;text-underline-offset:3px}
.women-preview__fits{grid-template-columns:repeat(2,minmax(0,1fr));max-width:920px}
.women-preview--regular-page .women-preview__gallery{padding-top:72px}
.women-preview--regular-page .women-preview__section-head h1{font-size:clamp(46px,6vw,78px);margin:0}
@media(max-width:720px){
  .women-product-page{overflow:hidden}
  .women-product-page .product-grid{width:100%}
  .women-product-page .media-thumbs{width:100%;max-width:100%;flex-wrap:nowrap;overflow-x:auto;padding-bottom:8px}
  .women-product-page .media-thumb{flex:0 0 64px}
  .women-product-page .native-colours,.women-product-page .native-sizes{max-width:100%}
}
</style>
