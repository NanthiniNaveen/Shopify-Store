<article class="art-card">
  <a href="{{ product.url }}">
    <div class="art-card-image photo">
      {% capture crop_card_image %}{% render 'n2d-crop-card-image', handle: product.handle %}{% endcapture %}
      {% assign card_model_image = crop_card_image | strip %}
      {% if card_model_image == blank %}
        {% capture oversized_card_image %}{% render 'n2d-oversized-card-image', handle: product.handle %}{% endcapture %}
        {% assign card_model_image = oversized_card_image | strip %}
      {% endif %}
      {% if card_model_image == blank %}
        {% capture regular_card_image %}{% render 'n2d-regular-card-image', handle: product.handle %}{% endcapture %}
        {% assign card_model_image = regular_card_image | strip %}
      {% endif %}
      {% if card_model_image == blank %}
        {% capture womens_card_image %}{% render 'n2d-womens-card-image', handle: product.handle %}{% endcapture %}
        {% assign card_model_image = womens_card_image | strip %}
      {% endif %}
      {% if card_model_image != blank %}
        <img src="{{ card_model_image }}" alt="Model wearing {{ product.title | escape }}" loading="lazy" width="1122" height="1402">
      {% else %}
        {% case product.handle %}
          {% when 'mens-plain-regular' %}
            <img src="{{ 'plain-regular-model.webp' | asset_url }}" alt="Model wearing the Men's Plain Regular T-shirt" loading="lazy" width="1024" height="1280">
          {% when 'mens-plain-oversized' %}
            <img src="{{ 'plain-oversized-model.webp' | asset_url }}" alt="Model wearing the Men's Plain Oversized T-shirt" loading="lazy" width="1024" height="1280">
          {% when 'womens-plain-regular' %}
            <img src="{{ 'women-plain-model-card.webp' | asset_url }}" alt="Model wearing the Women's Plain Regular T-shirt" loading="lazy" width="1024" height="1280">
          {% else %}
            {% if product.featured_image %}
              {% assign card_img = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
              {{ card_img | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag }}
            {% endif %}
        {% endcase %}
      {% endif %}
    </div>
    <h3>{{ product.title | escape }}</h3>
    <p>{% if settings.enable_purchasing %}{% if product.compare_at_price > product.price %}<strong class="sale-price">₹{{ product.price | money_without_currency | split: "." | first }}</strong> <span class="price-was">₹{{ product.compare_at_price | money_without_currency | split: "." | first }}</span>{% else %}₹{{ product.price | money_without_currency | split: "." | first }}{% endif %}{% else %}Collection preview{% endif %}</p>
  </a>
</article>